# Local development (`npm run dev`) works with these left blank. For a deployed Worker, the same two
# names can be set with `wrangler secret put <NAME>` or in the Cloudflare dashboard.

# Optional. Leave this blank. Without it, the first admin can be created by whoever opens the app first.
# If you fill it in, creating the first admin needs this key.
SETUP_KEY=

# Optional. Leave this blank. Without it, Wrangla generates a random signing key and keeps it in the database.
# If you fill it in, that value is used to sign logins instead.
SESSION_SECRET=

# Optional. Setting this turns on emailed two-factor login codes (see README).
# RESEND_API_KEY=re_xxxxxxxxxxxx
