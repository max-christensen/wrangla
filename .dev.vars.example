# Copy to .dev.vars for local development (`npm run dev`). .dev.vars is git-ignored.
# For a deployed Worker, set these with `wrangler secret put <NAME>` instead.
SESSION_SECRET=replace-with-a-long-random-string
SETUP_KEY=replace-with-a-one-time-password-for-creating-the-first-admin
# Optional. Setting this turns on emailed two-factor login codes (see README).
# RESEND_API_KEY=re_xxxxxxxxxxxx
