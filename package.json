{
  "name": "wrangla",
  "version": "1.0.0",
  "private": true,
  "description": "A small-business scheduling app that runs entirely on Cloudflare (Workers, D1 and R2).",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:init && wrangler deploy",
    "db:init": "wrangler d1 execute DB --remote --yes --file=./schema.sql",
    "db:init:local": "wrangler d1 execute DB --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
